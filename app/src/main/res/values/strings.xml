    <string name="about_title">Sobre o app</string>
    <string name="about_tagline">Organize. Pague. Conquiste.</string>
    <string name="about_description">O FinCheck é o seu checklist financeiro. Cadastre suas contas e despesas, acompanhe o que ainda falta pagar, marque o que já foi pago e veja quanto deve sobrar até o próximo recebimento. Tudo de forma simples, para você ter o controle do seu dinheiro sem complicação.</string>
